{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Cross-Origin-Embedder-Policy",
					"value": "require-corp"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/web/(.*)",
			"destination": "/web/$1"
		},
		{
			"source": "/(.*)",
			"destination": "/web/$1"
		}
	]
}
